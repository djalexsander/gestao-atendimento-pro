+// Templates (nada de texto livre do modelo)
+// ---------------------------------------------------------------------------
+export const MSG_REPROMPT = "Para enviar o pedido, responda CONFIRMAR. Se quiser alterar algo, é só me dizer.";
+export const MSG_NOT_FOUND = "Não encontrei esse item no cardápio. Quer que eu mostre as opções disponíveis?";
+export const MSG_NO_DRAFT = "Não encontrei um pedido em andamento. Quer fazer um pedido?";
+export const MSG_CANCELLED = "Pedido cancelado. Se quiser fazer outro, é só me dizer.";
+export const MSG_CANCEL_AFTER_ORDER = "Seu pedido já foi enviado para produção, então não consigo cancelar por aqui. Vou chamar a equipe para ajudar.";
+export const MSG_FAILED = "Não consegui finalizar o pedido. Vou encaminhar para a equipe.";
+export const MSG_ALREADY_CONFIRMED = "Seu pedido já foi confirmado e enviado para produção.";
+export const MSG_TOO_BIG = "O pedido ficou grande demais para eu montar por aqui. Vou chamar a equipe para ajudar.";
+
+const fulfillmentLabel = (f: string | null) => (f === "delivery" ? "entrega" : f === "pickup" ? "retirada" : "");
+const payWhen = (f: string | null) => (f === "delivery" ? "na entrega" : "na retirada");
+
+export function renderItemLine(it: OrderItem): string[] {
+  const out = [`${it.quantity}x ${plain(it.name, 80)} — ${brl(it.line_total)}`];
+  if (it.options.length) out.push(`   com ${it.options.map((o) => plain(o.name, 40)).join(", ")}`);
+  if (it.notes) out.push(`   obs.: ${plain(it.notes, 100)}`);
+  return out;
+}
+
+/** RESUMO COMPLETO (D8): tudo calculado pelo banco; aqui só apresentação. */
+export function renderSummary(s: OrderState, header = "Seu pedido"): string {
+  const lines: string[] = [`${header} — ${fulfillmentLabel(s.fulfillment).toUpperCase()}`];
+  for (const it of s.items) lines.push(...renderItemLine(it));
+  lines.push(`Subtotal: ${brl(s.items_total)}`);
+  if (s.fulfillment === "delivery") {
+    lines.push(`Taxa de entrega${s.zone ? ` (${plain(s.zone.name, 40)})` : ""}: ${brl(s.delivery_fee)}`);
+  }
+  lines.push(`Total: ${brl(s.grand_total)}`);
+  if (s.fulfillment === "delivery") {
+    const a = s.address;
+    const street = [plain(a.street, 100), plain(a.number, 20)].filter(Boolean).join(", ");
+    const place = [plain(a.complement, 50), plain(a.neighborhood, 60)].filter(Boolean).join(" · ");
+    const city = [plain(a.city, 60), plain(a.state, 4)].filter(Boolean).join("/");
+    lines.push(`Endereço: ${[street, place, city].filter(Boolean).join(" — ")}${a.city_inferred ? " (confirme a cidade)" : ""}`);
+    if (a.reference) lines.push(`Referência: ${plain(a.reference, 100)}`);
+    lines.push(`Previsão: cerca de ${s.estimated_minutes ?? s.settings.delivery_minutes} min`);
+  } else {
+    lines.push(`Previsão: cerca de ${s.settings.pickup_minutes} min`);
+  }
+  const p = s.payment;
+  if (p.method) {
+    let pay = `Pagamento: ${PAYMENT_LABELS[p.method] ?? p.method}`;
+    if (p.method === "cash") pay += p.change_for ? `, troco para ${brl(p.change_for)}` : ", sem troco";
+    lines.push(`${pay} (pago ${payWhen(s.fulfillment)})`);
+  }
+  if (s.contact_name) lines.push(`Em nome de: ${plain(s.contact_name, 60)}`);
+  if (s.notes) lines.push(`Obs.: ${plain(s.notes, 200)}`);
+  lines.push("", "Está correto? Responda CONFIRMAR para enviar o pedido ou me diga o que deseja alterar.");
+  return lines.join("\n");
+}
+
+const MISSING_LABEL: Record<string, string> = { street: "rua e número", neighborhood: "bairro", city: "cidade", state: "UF (estado, 2 letras)" };
+
+/** Próxima pergunta (UMA por mensagem) a partir das pendências do banco. */
+export function nextQuestion(s: OrderState): string | null {
+  const first = (code: string) => s.pendings.find((p) => p.code === code);
+  const un = first("item_unavailable");
+  if (un) return `${plain(un.name, 80)} não está disponível no momento. Quer remover ou escolher outro?`;
+  const inv = first("item_options_invalid");
+  if (inv) return `Preciso rever as opções de ${plain(inv.name, 80)}. Pode escolher novamente?`;
+  const req = first("item_options_required");
+  if (req && req.groups?.length) {
+    const g = req.groups[0];
+    const opts = g.options.map((o) => `${plain(o.name, 40)}${Number(o.price_delta) > 0 ? ` (+${brl(o.price_delta)})` : ""}`).join(", ");
+    return `Para ${plain(req.name, 80)}: ${plain(g.name, 40)}? ${opts}.`;
+  }
+  if (first("no_items")) return "O que você gostaria de pedir?";
+  if (first("delivery_disabled")) return "No momento não estamos fazendo entregas. Quer retirar no balcão?";
+  if (first("pickup_disabled")) return "No momento não estamos fazendo retirada. Quer receber por entrega?";
+  if (first("fulfillment")) return s.settings.delivery_enabled && s.settings.pickup_enabled ? "Prefere retirada no balcão ou entrega?" : s.settings.delivery_enabled ? "Será entrega. Qual o endereço?" : "Será retirada no balcão, certo?";
+  const addr = first("address_incomplete");
+  if (addr) {
+    const need = (addr.missing ?? []).map((m) => MISSING_LABEL[m] ?? m);
+    return `Para a entrega, preciso de: ${need.join(", ")}.`;
+  }
+  if (first("out_of_zone")) return "Não entregamos nesse endereço. Quer retirar no balcão ou informar outro endereço?";
+  if (first("payment_method")) {
+    const ms = s.payment.authorized_methods.map((m) => PAYMENT_LABELS[m] ?? m).join(", ");
+    return `Como prefere pagar? ${ms}. O pagamento é feito ${payWhen(s.fulfillment)}.`;
+  }
+  if (first("cash_change")) return `Vai precisar de troco? Se sim, para quanto? (o total é ${brl(s.grand_total)})`;
+  if (first("contact_name")) return "Em nome de quem fica o pedido?";
+  return null;
+}
+
+export function renderCreated(total: number | string, fulfillment: string, minutes: number | null): string {
+  const prev = minutes ? ` Previsão: cerca de ${minutes} min.` : "";
+  return `Pedido confirmado e enviado para produção. Total: ${brl(total)}${fulfillment === "delivery" ? " (com a taxa de entrega)" : ""}.${prev}`;
+}
+
+export function renderPriceChanges(changes: Array<{ name: string; old: number | string; new: number | string }>, oldFee: number | string | null, newFee: number | string | null, newTotal: number | string): string {
+  const lines: string[] = [];
+  for (const c of changes) lines.push(`O preço de ${plain(c.name, 80)} mudou de ${brl(c.old)} para ${brl(c.new)}.`);
+  if (oldFee !== null && newFee !== null && Number(oldFee) !== Number(newFee)) lines.push(`A taxa de entrega mudou de ${brl(oldFee)} para ${brl(newFee)}.`);
+  lines.push(`O novo total é ${brl(newTotal)}.`);
+  return lines.join("\n");
+}
+
+export function renderAmbiguous(candidates: Array<{ name: string; price: number | string }>): string {
+  const opts = candidates.slice(0, 5).map((c) => `${plain(c.name, 80)} (${brl(c.price)})`).join(", ");
+  return `Qual você prefere: ${opts}?`;
+}
+export function renderUnavailable(name: string): string {
+  return `${plain(name, 80)} não está disponível no momento.`;
+}
+export function renderAskQuantity(product: string): string {
+  return `Quantos ${plain(product, 80)} você quer?`;
+}
