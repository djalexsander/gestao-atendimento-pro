{
  "name": "print-agent",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "description": "Gestão Atendimento Pro - Agente de Impressão (Windows, Tauri 2)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "audit:secrets": "node scripts/check-no-service-role.mjs",
    "build:installer": "tauri build --bundles nsis",
    "build:installer:release": "tauri build --bundles nsis --config src-tauri/tauri.release.conf.json",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  }
}
