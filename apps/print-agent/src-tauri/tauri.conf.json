{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gestão Atendimento Pro - Agente de Impressão",
  "version": "0.2.0",
  "mainBinaryName": "print-agent",
  "identifier": "br.com.gestaoatendimentopro.printagent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gestão Atendimento Pro — Agente de Impressão",
        "width": 760,
        "height": 820,
        "minWidth": 480,
        "minHeight": 560,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,IntensiveWakeUpThrottling --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://*.supabase.co ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "ALEXPROAPPS",
    "shortDescription": "Agente de impressão do Gestão Atendimento Pro",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false,
        "startMenuFolder": "Gestão Atendimento Pro"
      }
    }
  }
}
